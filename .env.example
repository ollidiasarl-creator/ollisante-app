# Copier en .env (non versionné). Les variables EXPO_PUBLIC_* sont visibles dans l'application : aucune clé secrète ici.
# Sur téléphone, en développement, "localhost" ne marche pas : mettre l'adresse IP de l'ordinateur, ex. http://192.168.1.20:8088
EXPO_PUBLIC_API_URL=https://api.ollisante.com
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
